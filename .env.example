# Supabase (Project Settings → API). Leave empty to run in DEMO MODE (read-only sample data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL used for sitemap, Open Graph and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEVER expose the service-role key to the browser. It is NOT needed by the app.
